@model IReadOnlyList<SolicitudCredito>
@{
    ViewData["Title"] = "Panel del analista";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Solicitudes pendientes</h1>
            <p class="text-muted mb-0">Revisa y resuelve las solicitudes de crédito recibidas.</p>
        </div>
    </div>

    @if (TempData["MensajeExito"] is string mensajeExito)
    {
        <div class="alert alert-success" role="status">
            @mensajeExito
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No hay solicitudes pendientes para revisar.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Solicitudes recibidas</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">N.º</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Ingresos mensuales</th>
                            <th scope="col">Monto solicitado</th>
                            <th scope="col">Máximo 5×</th>
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model)
                        {
                            var ingresos = solicitud.Cliente?.IngresosMensuales ?? 0m;
                            var maximo = ingresos * 5m;
                            var cliente = solicitud.Cliente?.Usuario?.UserName
                                ?? solicitud.Cliente?.UsuarioId
                                ?? "Cliente no disponible";

                            <tr>
                                <td>@solicitud.Id</td>
                                <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                <td>@cliente</td>
                                <td>@ingresos.ToString("C")</td>
                                <td>@solicitud.MontoSolicitado.ToString("C")</td>
                                <td>@maximo.ToString("C")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end flex-wrap gap-2">
                                        <a asp-controller="Analista" asp-action="Aprobar" asp-route-id="@solicitud.Id" class="btn btn-sm btn-success">Aprobar</a>
                                        <a asp-controller="Analista" asp-action="Rechazar" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-danger">Rechazar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
