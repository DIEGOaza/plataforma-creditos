@model MisSolicitudesViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="container alert alert-success mt-4 mb-0" role="status">
        @mensajeExito
    </div>
}

@if (TempData["MensajeAdvertencia"] is string mensajeAdvertencia)
{
    <div class="container alert alert-warning mt-4 mb-0" role="alert">
        @mensajeAdvertencia
    </div>
}

<div class="container alert alert-info d-none mt-4 mb-0" data-solicitudes-live-status role="status" aria-live="polite"></div>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Mis solicitudes</h1>
            <p class="text-muted mb-0">Consulta y filtra tus solicitudes de crédito.</p>
        </div>
        <a asp-controller="Solicitudes" asp-action="Crear" class="btn btn-primary">Crear solicitud</a>
    </div>

    <section class="card mb-4" aria-labelledby="filtros-title">
        <div class="card-header">
            <h2 id="filtros-title" class="h5 mb-0">Filtros</h2>
        </div>
        <div class="card-body">
            <form asp-controller="Solicitudes" asp-action="MisSolicitudes" method="get">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="">Todos los estados</option>
                            @foreach (var estado in Enum.GetValues<EstadoSolicitud>())
                            {
                                <option value="@estado">@estado</option>
                            }
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MontoMinimo" class="form-label"></label>
                        <input asp-for="MontoMinimo" class="form-control" type="number" min="0" step="0.01" placeholder="Desde" />
                        <span asp-validation-for="MontoMinimo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MontoMaximo" class="form-label"></label>
                        <input asp-for="MontoMaximo" class="form-control" type="number" min="0" step="0.01" placeholder="Hasta" />
                        <span asp-validation-for="MontoMaximo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaInicio" class="form-label"></label>
                        <input asp-for="FechaInicio" class="form-control" type="date" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaFin" class="form-label"></label>
                        <input asp-for="FechaFin" class="form-control" type="date" />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Aplicar filtros</button>
                        <a asp-controller="Solicitudes" asp-action="MisSolicitudes" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </section>

    @if (Model.Solicitudes.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No se encontraron solicitudes que coincidan con los filtros indicados.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Resultados</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">N.º</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Monto</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Motivo de rechazo</th>
                            <th scope="col"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model.Solicitudes)
                        {
                            var estadoTexto = solicitud.Estado switch
                            {
                                EstadoSolicitud.Pendiente => "Pendiente",
                                EstadoSolicitud.Aprobado => "Aprobada",
                                EstadoSolicitud.Rechazado => "Rechazada",
                                _ => solicitud.Estado.ToString()
                            };
                            var estadoClase = solicitud.Estado switch
                            {
                                EstadoSolicitud.Pendiente => "bg-warning text-dark",
                                EstadoSolicitud.Aprobado => "bg-success",
                                EstadoSolicitud.Rechazado => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr data-solicitud-id="@solicitud.Id">
                                <td>@solicitud.Id</td>
                                <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                <td>@solicitud.MontoSolicitado.ToString("C")</td>
                                <td><span data-solicitud-estado class="badge @estadoClase">@estadoTexto</span></td>
                                <td data-solicitud-motivo>@(string.IsNullOrWhiteSpace(solicitud.MotivoRechazo) ? "—" : solicitud.MotivoRechazo)</td>
                                <td class="text-end">
                                    <a asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
